.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  height: 72px;
  padding-top: 8px;
  padding-left: 14px;
  padding-right: 14px;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  border-radius: 18px 18px 0 0;
  background: rgba(254, 248, 242, 0.94);
  border-top: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 -6px 24px rgba(63, 103, 81, 0.08);
  backdrop-filter: blur(12px);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 56px;
  border-radius: 16px;
  color: rgba(65, 73, 67, 0.62);
  transition:
    background-color 0.18s ease,
    color 0.18s ease,
    transform 0.12s ease,
    box-shadow 0.18s ease;
}

.tab-item:active {
  transform: scale(0.96);
}

.tab-item.active {
  background: rgba(63, 103, 81, 0.92);
  color: #c0edd1;
  box-shadow: 0 2px 10px rgba(63, 103, 81, 0.16);
}

.tab-icon {
  width: 22px;
  height: 22px;
  margin-bottom: 3px;
}

.tab-label {
  font-family: 'Nunito Sans', 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.04em;
  color: inherit;
}
