.stats-page {
  min-height: 100vh;
  padding: 16px 18px calc(28px + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(91, 50, 202, 0.06) 0%, transparent 180px), #faf8f5;
  box-sizing: border-box;
}

.page-desc {
  margin-top: 0;
  font-size: 13px;
  color: #8174a9;
  font-weight: 500;
  line-height: 1.55;
}

.page-desc.lead {
  margin-bottom: 4px;
}

.kpi-grid {
  margin-top: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.kpi-card {
  border-radius: 24px;
  padding: 18px 16px;
  min-height: 110px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 3px 12px rgba(29, 27, 24, 0.03);
}

.kpi-card.streak {
  background: #f4f3fc;
  border: 1px solid #e9e6f6;
}
.kpi-card.today {
  background: #f2faf5;
  border: 1px solid #e5f3eb;
}
.kpi-card.rate {
  background: #fcf7f2;
  border: 1px solid #f5ece2;
}
.kpi-card.time {
  background: #fdf3f3;
  border: 1px solid #f7eaeb;
}

.kpi-label {
  font-size: 12px;
  font-weight: 800;
  color: #8174a9;
}

.kpi-card.today .kpi-label {
  color: #71a488;
}
.kpi-card.rate .kpi-label {
  color: #a1826f;
}
.kpi-card.time .kpi-label {
  color: #aa7474;
}

.kpi-value {
  font-size: 32px;
  font-weight: 900;
  color: #2a165c;
  line-height: 1;
}

.kpi-card.today .kpi-value {
  color: #174c32;
}
.kpi-card.rate .kpi-value {
  color: #523624;
}
.kpi-card.time .kpi-value {
  color: #5c1d1d;
}

.kpi-unit {
  margin-left: 4px;
  font-size: 13px;
  font-weight: 700;
}

.panel {
  margin-top: 14px;
  background: #fff;
  border-radius: 28px;
  border: 1px solid rgba(233, 230, 246, 0.8);
  padding: 18px;
}

.panel-title {
  font-size: 15px;
  font-weight: 900;
  color: #2a165c;
  margin-bottom: 14px;
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  height: 120px;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.chart-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 70%;
  max-width: 22px;
  border-radius: 999px 999px 8px 8px;
  background: linear-gradient(180deg, #5b32ca, #8174a9);
  min-height: 8px;
}

.chart-value {
  margin-top: 6px;
  font-size: 10px;
  font-weight: 800;
  color: #8174a9;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-top: 1px solid #f5f5f4;
  font-size: 13px;
  color: #78716c;
  font-weight: 600;
}

.meta-row:first-of-type {
  border-top: none;
  padding-top: 0;
}

.meta-strong {
  font-weight: 900;
  color: #2a165c;
}

.deck-stat {
  margin-top: 12px;
}

.deck-stat-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  color: #44403c;
}

.deck-track {
  margin-top: 8px;
  height: 8px;
  border-radius: 999px;
  background: #f5f5f4;
  overflow: hidden;
}

.deck-fill {
  height: 100%;
  border-radius: 999px;
  background: #5b32ca;
}
