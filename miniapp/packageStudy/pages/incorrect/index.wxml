<view class="list-page">
  <view class="page-head">
    <view class="page-desc lead">针对攻克难关，把薄弱点练扎实。</view>
    <view wx:if="{{!isEmpty}}" class="clear-btn" bindtap="onClearAll">清空</view>
  </view>

  <view wx:if="{{isEmpty}}" class="empty-card">
    <view class="empty-emoji">✓</view>
    <view class="empty-title">暂无错题</view>
    <view class="empty-desc">刷题或考试答错的题目会自动收录到这里。</view>
  </view>

  <block wx:else>
    <view class="restudy-btn" bindtap="onRestudy">开始重练 {{items.length}} 题</view>
    <view class="item-list">
      <view wx:for="{{items}}" wx:key="id" class="item-card">
        <view class="item-top">
          <view class="kind-pill red">{{item.kindLabel}}</view>
          <view class="remove-btn" data-id="{{item.id}}" catchtap="onRemove">移除</view>
        </view>
        <view class="item-stem">{{item.stem}}</view>
        <view class="item-answer">正确答案：{{item.answerLabel}}</view>
        <view wx:if="{{item.explanation}}" class="item-exp">{{item.explanation}}</view>
      </view>
    </view>
  </block>
</view>
