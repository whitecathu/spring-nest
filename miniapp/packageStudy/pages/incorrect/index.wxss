.list-page {
  min-height: 100vh;
  padding: 16px 18px calc(28px + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(178, 56, 56, 0.06) 0%, transparent 180px), #faf8f5;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 4px;
}

.page-desc {
  margin-top: 0;
  font-size: 13px;
  color: #aa7474;
  font-weight: 500;
  line-height: 1.55;
  flex: 1;
}

.page-desc.lead {
  margin-bottom: 0;
}

.clear-btn {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 800;
  color: #b23838;
  padding: 6px 10px;
  margin-top: -2px;
  border-radius: 999px;
  background: rgba(178, 56, 56, 0.08);
}

.empty-card {
  margin-top: 28px;
  background: #fff;
  border-radius: 28px;
  border: 1px dashed #f7eaeb;
  padding: 36px 20px;
  text-align: center;
}

.empty-emoji {
  width: 52px;
  height: 52px;
  margin: 0 auto 10px;
  border-radius: 999px;
  background: #fdf3f3;
  color: #b23838;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 900;
}

.empty-title {
  font-size: 15px;
  font-weight: 900;
  color: #5c1d1d;
}

.empty-desc {
  margin-top: 8px;
  font-size: 12px;
  color: #aa7474;
  line-height: 1.6;
}

.restudy-btn {
  margin-top: 20px;
  background: #b23838;
  color: #fff;
  border-radius: 999px;
  padding: 14px;
  text-align: center;
  font-size: 13px;
  font-weight: 900;
  box-shadow: 0 3px 12px rgba(178, 56, 56, 0.2);
  transition: transform 0.1s ease;
}

.restudy-btn:active {
  transform: scale(0.98);
}

.item-list {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.item-card {
  background: #fff;
  border-radius: 22px;
  border: 1px solid #f7eaeb;
  padding: 16px;
  box-shadow: 0 2px 10px rgba(29, 27, 24, 0.03);
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kind-pill {
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 900;
}

.kind-pill.red {
  background: #fdf3f3;
  color: #b23838;
}

.kind-pill.green {
  background: #f2faf5;
  color: #1d8554;
}

.remove-btn {
  font-size: 11px;
  font-weight: 800;
  color: #a8a29e;
  padding: 4px 8px;
}

.item-stem {
  margin-top: 10px;
  font-size: 14px;
  font-weight: 800;
  color: #292524;
  line-height: 1.55;
}

.item-answer {
  margin-top: 8px;
  font-size: 12px;
  font-weight: 800;
  color: #1b4332;
}

.item-exp {
  margin-top: 6px;
  font-size: 12px;
  color: #78716c;
  line-height: 1.5;
}
