.import-page {
  min-height: 100vh;
  padding: 16px 18px calc(28px + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(165, 208, 182, 0.14) 0%, transparent 200px), #faf8f5;
  box-sizing: border-box;
}

.page-desc {
  margin-top: 0;
  font-size: 14px;
  color: rgba(120, 113, 108, 0.95);
  font-weight: 500;
  line-height: 1.55;
}

.page-desc.lead {
  margin-bottom: 4px;
}

.back-edit {
  display: inline-flex;
  align-items: center;
  margin: 10px 0 4px;
  font-size: 13px;
  font-weight: 700;
  color: #2d6a4f;
}

.file-card {
  margin-top: 22px;
  background: #fff;
  border-radius: 28px;
  border: 1px solid rgba(214, 211, 209, 0.4);
  padding: 36px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  box-shadow: 0 6px 24px rgba(29, 27, 24, 0.04);
  transition: transform 0.12s ease;
}

.file-card:active {
  transform: scale(0.985);
}

.file-icon {
  width: 84px;
  height: 84px;
  border-radius: 24px;
  background: #faf3eb;
  color: #8b786d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.file-title {
  font-size: 20px;
  font-weight: 900;
  color: #1c1917;
}

.file-desc {
  font-size: 13px;
  color: #78716c;
  font-weight: 500;
  line-height: 1.6;
  max-width: 280px;
}

.error-banner {
  margin-top: 14px;
  padding: 14px;
  border-radius: 18px;
  background: #fff1f2;
  border: 1px solid rgba(255, 228, 230, 0.8);
  color: #e11d48;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
}

.paste-card,
.meta-card,
.preview-card,
.format-tip {
  margin-top: 16px;
  background: #fff;
  border-radius: 28px;
  border: 1px solid rgba(214, 211, 209, 0.4);
  padding: 18px;
}

.paste-label,
.field-label,
.preview-head,
.tip-title {
  font-size: 12px;
  font-weight: 900;
  color: #1b4332;
  letter-spacing: 0.04em;
  margin-bottom: 10px;
}

.paste-area {
  width: 100%;
  min-height: 160px;
  background: #fcfbf9;
  border-radius: 18px;
  padding: 12px;
  font-size: 13px;
  color: #44403c;
  box-sizing: border-box;
}

.field-input {
  width: 100%;
  height: 48px;
  background: #fcfbf9;
  border-radius: 16px;
  padding: 0 14px;
  font-size: 15px;
  font-weight: 700;
  line-height: 48px;
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
  color: #1b4332;
}

.emoji-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.emoji-chip {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.emoji-chip.active {
  background: #e2efe9;
  box-shadow: inset 0 0 0 1.5px #1b4332;
}

.preview-item {
  padding: 12px 0;
  border-top: 1px solid #f5f5f4;
}

.preview-item:first-of-type {
  border-top: none;
}

.preview-stem {
  font-size: 13px;
  font-weight: 700;
  color: #292524;
  line-height: 1.5;
}

.preview-answer {
  margin-top: 4px;
  font-size: 11px;
  font-weight: 800;
  color: #2d6a4f;
}

.tip-line {
  font-size: 12px;
  color: #78716c;
  font-weight: 500;
  line-height: 1.7;
}

.btn-forest {
  margin-top: 14px;
  background: #1b4332;
  color: #fff;
  border-radius: 999px;
  padding: 14px 20px;
  text-align: center;
  font-size: 13px;
  font-weight: 900;
}

.save-btn {
  margin-top: 20px;
}
