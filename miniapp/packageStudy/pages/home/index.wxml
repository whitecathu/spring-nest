<view class="study-page">
  <view class="hero">
    <view class="hero-kicker">QUESTION BANK</view>
    <view class="hero-title">学习小筑</view>
    <view class="hero-desc">题集驱动的背题、刷题与模拟考试。</view>
  </view>

  <view class="bento">
    <view class="bento-card bento-import" bindtap="goImport">
      <view class="bento-icon">✨</view>
      <view class="bento-title">导入题库</view>
      <view class="bento-muted">支持导入文件</view>
    </view>
    <view class="bento-card bento-incorrect" bindtap="goIncorrect">
      <view class="bento-icon">✗</view>
      <view class="bento-title">错题本</view>
      <view class="bento-muted">针对攻克难关</view>
    </view>
    <view class="bento-card bento-fav" bindtap="goFavorites">
      <view class="bento-icon">♡</view>
      <view class="bento-title">收藏夹</view>
      <view class="bento-muted">常看卡片库</view>
    </view>
    <view class="bento-card bento-stats" bindtap="goStats">
      <view class="bento-icon">▤</view>
      <view class="bento-title">学习统计</view>
      <view class="bento-muted">复习曲线进度</view>
    </view>
  </view>

  <view wx:if="{{activeSession}}" class="resume-bar">
    <view class="resume-left">
      <view class="resume-icon">⏱</view>
      <view class="resume-copy">
        <view class="resume-title">{{resumeLabel}}</view>
        <view class="resume-meta">{{resumeMeta}}</view>
      </view>
    </view>
    <view class="resume-actions">
      <view class="btn-ghost-sm" bindtap="onDiscardSession">放弃</view>
      <view class="btn-forest-sm" bindtap="onResumeSession">继续</view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">我的题集</view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="搜索题集、题干、答案或分类"
      value="{{searchQuery}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <view wx:if="{{searchQuery}}" class="search-clear" bindtap="onClearSearch">×</view>
  </view>
  <view wx:if="{{searchHint}}" class="search-hint">{{searchHint}}</view>

  <view class="deck-list">
    <block wx:for="{{filteredDecks}}" wx:key="id">
      <view class="deck-card" data-id="{{item.id}}" bindtap="goDeck">
        <view class="deck-emoji">{{item.emoji || '📖'}}</view>
        <view class="deck-body">
          <view class="deck-name">{{item.name}}</view>
          <view class="deck-meta">
            <text>{{searchQuery ? (item.matchCount + '/' + item.questionCount) : item.questionCount}} 题目</text>
            <text>上次复习: {{item.lastReviewedLabel}}</text>
          </view>
          <view class="mastery-row">
            <view class="mastery-track">
              <view class="mastery-fill" style="width: {{item.masteryRate}}%;"></view>
            </view>
            <text class="mastery-label">掌握 {{item.masteryRate}}%</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{isEmpty}}" class="empty-card">
      <view class="empty-emoji">📚</view>
      <view class="empty-title">暂无题集</view>
      <view class="empty-desc">导入 TXT / JSON / CSV，或先体验一份示例题集。</view>
      <view class="empty-actions">
        <view class="btn-forest" bindtap="goImport">导入第一个题库</view>
        <view class="btn-outline" bindtap="onSeedSample">加入示例题集</view>
      </view>
    </view>

    <view wx:elif="{{filteredDecks.length === 0}}" class="empty-card">
      <view class="empty-title">没有匹配题集</view>
      <view class="empty-desc">可按题集名称、题干、答案或分类继续搜索。</view>
    </view>
  </view>
</view>
