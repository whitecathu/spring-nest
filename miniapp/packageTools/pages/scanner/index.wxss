.scan-stage {
  position: relative;
  height: 420px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(237, 231, 225, 0.55) 100%);
}

.scan-canvas {
  width: 100%;
  height: 100%;
}

.scan-canvas.legacy {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0.01;
  pointer-events: none;
}

.empty-hint {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 28px 24px;
  text-align: center;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-chip {
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(237, 231, 225, 0.9);
  color: var(--on-surface);
  font-size: 13px;
  font-weight: 600;
  border: 1px solid rgba(193, 200, 193, 0.25);
  transition:
    transform 0.1s ease,
    background-color 0.15s ease;
}

.filter-chip:active {
  transform: scale(0.96);
}

.filter-chip.on {
  background: var(--primary);
  color: var(--on-primary);
  border-color: transparent;
  box-shadow: 0 2px 8px rgba(39, 79, 58, 0.2);
}

.row {
  display: flex;
  align-items: center;
}
.gap-md {
  gap: 12px;
}
.flex-1 {
  flex: 1;
}
