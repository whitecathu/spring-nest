.notice {
  padding: 16px;
}

.notice-title {
  display: block;
  font-family: var(--font-heading);
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 6px;
  letter-spacing: -0.01em;
}

.notice-body {
  display: block;
  font-size: 13px;
  color: var(--on-surface-variant);
  line-height: 1.65;
  opacity: 0.95;
}

.file-card {
  padding: 16px;
}

.file-name {
  display: block;
  font-weight: 700;
  color: var(--on-surface);
  word-break: break-all;
  letter-spacing: -0.01em;
}

.file-meta {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--outline);
}

.extract {
  margin-top: 4px;
  padding: 16px;
}

.extract-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}

.extract-body {
  display: block;
  font-size: 13px;
  line-height: 1.6;
  color: var(--on-surface);
  white-space: pre-wrap;
  max-height: 240px;
  overflow: auto;
}

.row { display: flex; align-items: center; }
.gap-md { gap: 12px; }
.flex-1 { flex: 1; }
