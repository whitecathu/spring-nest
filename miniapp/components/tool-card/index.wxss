.tool-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  padding: 18px;
  min-height: 128px;
  justify-content: space-between;
  overflow: hidden;
  background: rgba(248, 243, 236, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4px 18px rgba(63, 103, 81, 0.06);
  border-radius: 22px;
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

.tool-card:active {
  transform: scale(0.98);
  box-shadow: 0 2px 10px rgba(63, 103, 81, 0.05);
}

.tool-card.mode-grid .title {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.tool-card.mode-grid .desc {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.4;
  opacity: 0.9;
}

/* Hero */
.tool-card.mode-hero {
  flex-direction: row;
  align-items: center;
  min-height: auto;
  padding: 18px 16px 18px 18px;
  gap: 0;
}

.tool-card.mode-hero .meta {
  margin-left: 14px;
  margin-right: 6px;
}

.tool-card.mode-hero .title {
  font-size: 17px;
  font-weight: 700;
}

.tool-card.mode-hero .desc {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: normal;
  line-height: 1.4;
  margin-top: 2px;
}

/* Quick */
.tool-card.mode-quick {
  align-items: center;
  justify-content: center;
  min-height: 94px;
  padding: 12px 8px;
  gap: 8px;
  border-radius: 18px;
}

.tool-card.mode-quick .quick-well {
  width: 42px;
  height: 42px;
  border-radius: 999px;
}

.tool-card.mode-quick .title {
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  letter-spacing: 0.01em;
}

/* Dev */
.tool-card.mode-dev {
  flex-direction: column;
  align-items: stretch;
  min-height: auto;
  gap: 12px;
  padding: 18px;
}

.dev-top {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.tool-card.mode-dev .dev-well {
  width: 52px;
  height: 52px;
  border-radius: 16px;
}

.tool-card.mode-dev .meta {
  position: relative;
  z-index: 1;
  margin-top: 2px;
}

.tool-card.mode-dev .title {
  font-size: 17px;
  font-weight: 700;
  white-space: normal;
  letter-spacing: -0.01em;
}

.tool-card.mode-dev .desc-wrap {
  white-space: normal;
  margin-top: 4px;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.45;
  color: rgba(65, 73, 67, 0.88);
}

.blob {
  position: absolute;
  border-radius: 999px;
  pointer-events: none;
  z-index: 0;
}

.blob-primary {
  right: -40px;
  top: -40px;
  width: 128px;
  height: 128px;
  background: rgba(165, 208, 182, 0.14);
}

.blob-tertiary {
  right: -24px;
  bottom: -24px;
  width: 96px;
  height: 96px;
  background: rgba(255, 219, 206, 0.14);
}

/* Doc */
.tool-card.mode-doc {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12px;
  min-height: 112px;
  padding: 16px;
}

.tool-card.mode-doc .doc-well {
  width: 52px;
  height: 52px;
  border-radius: 16px;
}

.tool-card.mode-doc .doc-title {
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  letter-spacing: 0.02em;
  white-space: normal;
  line-height: 1.35;
}

.meta {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.title {
  font-family: var(--font-heading);
  font-size: 17px;
  font-weight: 700;
  color: var(--on-surface);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--on-surface-variant);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  flex-shrink: 0;
  font-size: 22px;
  line-height: 1;
  color: rgba(193, 200, 193, 0.95);
  font-weight: 300;
}

.chevron-sm {
  font-size: 18px;
  color: rgba(65, 73, 67, 0.42);
}

.icon-well {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 1px 3px rgba(63, 103, 81, 0.05);
  flex-shrink: 0;
}

.icon-emoji {
  font-size: 21px;
  line-height: 1;
}
