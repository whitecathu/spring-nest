.result-card {
  padding: 16px 16px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  border-radius: 20px;
}

.row.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.badge {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--primary);
  background: rgba(39, 79, 58, 0.1);
  padding: 3px 9px;
  border-radius: 999px;
}

.badge.err {
  color: var(--error);
  background: var(--error-container);
}

.content {
  font-size: 14px;
  color: var(--on-surface);
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.6;
}

.status-error {
  border-color: rgba(186, 26, 26, 0.28);
  background: rgba(255, 218, 214, 0.28);
}
