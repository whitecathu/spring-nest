.result-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(63, 103, 81, 0.08);
}

.result-card--warning {
  background: #fff7e8;
}

.result-card--success {
  background: #eef8f2;
}

.result-card__title {
  color: #1a1c1a;
  font-size: 28rpx;
  font-weight: 850;
}

.result-card__content {
  margin-top: 10rpx;
  color: #615e59;
  font-size: 26rpx;
  line-height: 1.6;
}
