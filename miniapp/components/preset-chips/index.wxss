.chips {
  white-space: nowrap;
  width: 100%;
  padding: 2px 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 14px;
  margin-right: 8px;
  border-radius: 999px;
  background: rgba(237, 231, 225, 0.85);
  color: var(--on-surface-variant);
  font-size: 12px;
  font-weight: 700;
  border: 1px solid rgba(193, 200, 193, 0.28);
  transition: transform 0.1s ease, background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

.chip:active {
  transform: scale(0.96);
}

.chip.active {
  background: rgba(192, 237, 209, 0.55);
  color: var(--primary);
  border-color: rgba(39, 79, 58, 0.28);
  box-shadow: 0 1px 4px rgba(63, 103, 81, 0.08);
}
