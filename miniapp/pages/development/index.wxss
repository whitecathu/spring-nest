.development {
  min-height: 100vh;
  background: var(--page-wash);
}

.development .page-pad {
  background: transparent;
  min-height: auto;
  padding-top: 14px;
}

.page-intro {
  padding-left: 2px;
}

.subtitle {
  display: block;
  margin-top: 6px;
  opacity: 0.82;
  line-height: 1.55;
}

.section-label {
  padding-left: 2px;
}

.section-icon {
  font-size: 13px;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
  opacity: 0.9;
}

.section-icon.heart {
  color: var(--secondary);
  font-size: 15px;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 14px;
}

.development .section-gap {
  margin-top: 26px;
}
