.row.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 2px;
}

.clear {
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(39, 79, 58, 0.08);
}

.clear:active {
  background: rgba(39, 79, 58, 0.14);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.item:active {
  transform: scale(0.985);
}

.title {
  display: block;
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--on-surface);
  letter-spacing: -0.01em;
}

.time {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--on-surface-variant);
  opacity: 0.88;
}

.remove {
  font-size: 12px;
  font-weight: 600;
  color: var(--outline);
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(193, 200, 193, 0.18);
}

.remove:active {
  background: rgba(193, 200, 193, 0.32);
}

.empty {
  padding: 28px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  border-radius: 22px;
}
