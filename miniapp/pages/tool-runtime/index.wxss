.calc {
  padding: 18px 16px 16px;
}

.calc-display {
  display: block;
  text-align: right;
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--primary);
  min-height: 52px;
  margin-bottom: 14px;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}

.calc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.calc-key {
  height: 50px;
  border-radius: 16px;
  background: rgba(237, 231, 225, 0.9);
  color: var(--on-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 18px;
  transition: transform 0.1s ease, background-color 0.12s ease;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

.calc-key:active {
  transform: scale(0.96);
  background: rgba(231, 226, 219, 1);
}

.calc-key.eq {
  background: var(--primary);
  color: var(--on-primary);
  box-shadow: 0 2px 8px rgba(39, 79, 58, 0.22);
}

.calc-key.eq:active {
  background: var(--primary-container);
}

.calc-key.ghost {
  opacity: 0;
  pointer-events: none;
}

.area {
  min-height: 140px;
  width: 100%;
  height: auto;
  padding: 12px 15px;
  line-height: 1.55;
}

.hint {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  color: var(--on-surface-variant);
  line-height: 1.55;
  opacity: 0.88;
}

.switches {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.switch-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--on-surface);
  padding: 4px 0;
}

.swatch {
  height: 76px;
  border-radius: 18px;
  border: 1px solid rgba(193, 200, 193, 0.35);
  margin-bottom: 10px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

.diff {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  background: rgba(248, 243, 236, 0.9);
  border-radius: 16px;
  padding: 12px;
  margin-top: 12px;
  border: 1px solid rgba(193, 200, 193, 0.22);
}

.diff-row.add { color: #195125; }
.diff-row.del { color: #93000a; text-decoration: line-through; opacity: 0.85; }
.diff-row.same { color: var(--on-surface-variant); }

.md {
  padding: 14px;
  font-size: 14px;
  line-height: 1.65;
  margin-top: 12px;
}

.compass {
  padding: 28px 16px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.compass-ring {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  border: 2px solid rgba(39, 79, 58, 0.22);
  background: radial-gradient(circle at 50% 42%, #fff 0%, #f8f3ec 62%, #ede7e1 100%);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(63, 103, 81, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.7);
}

.compass-mark {
  position: absolute;
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
}

.compass-mark.n { top: 10px; left: 50%; transform: translateX(-50%); }
.compass-mark.s { bottom: 10px; left: 50%; transform: translateX(-50%); }
.compass-mark.e { right: 12px; top: 50%; transform: translateY(-50%); }
.compass-mark.w { left: 12px; top: 50%; transform: translateY(-50%); }

.needle {
  width: 8px;
  height: 90px;
  background: linear-gradient(#ba1a1a 0 45%, var(--primary) 55% 100%);
  border-radius: 8px;
  transform-origin: 50% 80%;
  margin-top: -20px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
}

.heading {
  font-size: 22px;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: -0.02em;
}

.timer {
  padding: 40px 24px 34px;
  align-items: center;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(248, 243, 236, 0.95) 100%);
}

.timer-num {
  font-family: var(--font-heading);
  font-size: 56px;
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.08;
}

.timer .hint {
  margin-top: 0;
  font-size: 13px;
  opacity: 0.75;
  letter-spacing: 0.02em;
}

.row { display: flex; align-items: center; }
.gap-md { gap: 12px; }
.flex-1 { flex: 1; }

.btn-primary,
.btn-ghost {
  margin-top: 0;
}

.active-chip {
  background: var(--primary-fixed) !important;
  color: var(--primary) !important;
  border-color: rgba(39, 79, 58, 0.28) !important;
  box-shadow: 0 1px 4px rgba(63, 103, 81, 0.08);
}

.qr-wrap {
  margin-top: 14px;
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.qr-grid {
  display: grid;
  gap: 0;
  background: #fff;
  padding: 10px;
  border-radius: 12px;
  image-rendering: pixelated;
  box-shadow: 0 2px 10px rgba(29, 27, 24, 0.06);
}

.qr-cell {
  width: 100%;
  aspect-ratio: 1;
  background: #fff;
}

.qr-cell.on {
  background: #1d1b18;
}

.qr-save-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 200px;
  height: 200px;
  pointer-events: none;
  opacity: 0;
}
