<tool-shell
  wx:if="{{tool}}"
  title="{{tool.title}}"
  desc="{{tool.description}}"
  icon="{{tool.icon}}"
  bg="{{tool.bg}}"
  color="{{tool.color}}"
  favorite="{{favorite}}"
  bind:togglefavorite="onToggleFavorite"
>
  <!-- Calculator -->
  <block wx:if="{{slug === 'calculator'}}">
    <view class="calc glass-card">
      <text class="calc-display">{{calcDisplay}}</text>
      <view class="calc-grid">
        <block wx:for="{{calcKeys}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
          <view
            wx:for="{{row}}"
            wx:for-item="key"
            wx:for-index="ki"
            wx:key="ki"
            class="calc-key {{key === '=' ? 'eq' : ''}} {{!key ? 'ghost' : ''}}"
            data-key="{{key}}"
            data-action="key"
            bindtap="handleAction"
          >{{key}}</view>
        </block>
      </view>
    </view>
  </block>

  <!-- Word counter -->
  <block wx:elif="{{slug === 'word-counter'}}">
    <textarea class="field area" placeholder="粘贴或输入文本" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">统计</button>
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制结果</button>
    </view>
  </block>

  <!-- Case converter -->
  <block wx:elif="{{slug === 'case-converter'}}">
    <textarea class="field area" placeholder="输入文本" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <picker mode="selector" range="{{caseModeLabels}}" bindchange="onCaseMode">
      <view class="field">模式：{{caseModeLabel}}</view>
    </picker>
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">转换</button>
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制结果</button>
    </view>
  </block>

  <!-- JSON -->
  <block wx:elif="{{slug === 'json-formatter'}}">
    <textarea class="field area" placeholder='{"hello":"spring"}' value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">格式化</button>
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制</button>
    </view>
  </block>

  <!-- Base64 -->
  <block wx:elif="{{slug === 'base64-codec'}}">
    <textarea class="field area" placeholder="输入文本" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="encode" bindtap="handleAction">编码</button>
      <button class="btn-ghost flex-1" data-action="decode" bindtap="handleAction">解码</button>
    </view>
  </block>

  <!-- URL -->
  <block wx:elif="{{slug === 'url-codec'}}">
    <textarea class="field area" placeholder="输入 URL 或文本" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="encode" bindtap="handleAction">编码</button>
      <button class="btn-ghost flex-1" data-action="decode" bindtap="handleAction">解码</button>
    </view>
  </block>

  <!-- Password -->
  <block wx:elif="{{slug === 'password'}}">
    <view class="field">长度 {{pwdLength}}</view>
    <slider min="4" max="64" value="{{pwdLength}}" show-value data-field="pwdLength" bindchange="onSlider" bindchanging="onSlider" />
    <view class="switches">
      <label class="switch-row"><switch checked="{{pwdLower}}" data-field="pwdLower" bindchange="onSwitch" />小写</label>
      <label class="switch-row"><switch checked="{{pwdUpper}}" data-field="pwdUpper" bindchange="onSwitch" />大写</label>
      <label class="switch-row"><switch checked="{{pwdDigits}}" data-field="pwdDigits" bindchange="onSwitch" />数字</label>
      <label class="switch-row"><switch checked="{{pwdSymbols}}" data-field="pwdSymbols" bindchange="onSwitch" />符号</label>
    </view>
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">生成密码</button>
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制</button>
    </view>
  </block>

  <!-- Random number -->
  <block wx:elif="{{slug === 'random-number'}}">
    <view class="row gap-md">
      <input class="field flex-1" type="number" placeholder="最小" value="{{numberMin}}" data-field="numberMin" bindinput="handleFieldInput" />
      <input class="field flex-1" type="number" placeholder="最大" value="{{numberMax}}" data-field="numberMax" bindinput="handleFieldInput" />
    </view>
    <button class="btn-primary" data-action="run" bindtap="handleAction">掷一下</button>
  </block>

  <!-- Random picker -->
  <block wx:elif="{{slug === 'random-picker'}}">
    <textarea class="field area" placeholder="每行一个选项" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <button class="btn-primary" data-action="run" bindtap="handleAction">帮我选</button>
  </block>

  <!-- Tip -->
  <block wx:elif="{{slug === 'tip-calculator'}}">
    <input class="field" type="digit" placeholder="账单金额" value="{{tipBill}}" data-field="tipBill" bindinput="handleFieldInput" />
    <input class="field" type="number" placeholder="小费 %" value="{{tipPercent}}" data-field="tipPercent" bindinput="handleFieldInput" />
    <input class="field" type="number" placeholder="人数" value="{{tipPeople}}" data-field="tipPeople" bindinput="handleFieldInput" />
    <button class="btn-primary" data-action="run" bindtap="handleAction">计算</button>
  </block>

  <!-- BMI -->
  <block wx:elif="{{slug === 'bmi-calculator'}}">
    <input class="field" type="digit" placeholder="身高 cm" value="{{bmiHeight}}" data-field="bmiHeight" bindinput="handleFieldInput" />
    <input class="field" type="digit" placeholder="体重 kg" value="{{bmiWeight}}" data-field="bmiWeight" bindinput="handleFieldInput" />
    <button class="btn-primary" data-action="run" bindtap="handleAction">计算 BMI</button>
  </block>

  <!-- Converter -->
  <block wx:elif="{{slug === 'converter'}}">
    <picker mode="selector" range="{{unitKindLabels}}" bindchange="onUnitKind">
      <view class="field">类型：{{unitKindLabel}}</view>
    </picker>
    <input class="field" type="digit" placeholder="数值" value="{{unitValue}}" data-field="unitValue" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <input class="field flex-1" placeholder="从" value="{{unitFrom}}" data-field="unitFrom" bindinput="handleFieldInput" />
      <input class="field flex-1" placeholder="到" value="{{unitTo}}" data-field="unitTo" bindinput="handleFieldInput" />
    </view>
    <text class="hint">长度: m/km/cm/mm/mi/ft/in · 重量: kg/g/lb/oz · 温度: C/F/K</text>
    <button class="btn-primary" data-action="run" bindtap="handleAction">换算</button>
  </block>

  <!-- Color -->
  <block wx:elif="{{slug === 'color-converter'}}">
    <view class="swatch" style="background: {{colorHex}};"></view>
    <input class="field" placeholder="#274F3A" value="{{colorHex}}" data-field="colorHex" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <input class="field flex-1" type="number" placeholder="R" value="{{colorR}}" data-field="colorR" bindinput="handleFieldInput" />
      <input class="field flex-1" type="number" placeholder="G" value="{{colorG}}" data-field="colorG" bindinput="handleFieldInput" />
      <input class="field flex-1" type="number" placeholder="B" value="{{colorB}}" data-field="colorB" bindinput="handleFieldInput" />
    </view>
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="hex" bindtap="handleAction">HEX→RGB</button>
      <button class="btn-ghost flex-1" data-action="rgb" bindtap="handleAction">RGB→HEX</button>
    </view>
  </block>

  <!-- Date -->
  <block wx:elif="{{slug === 'date-calculator'}}">
    <picker mode="date" value="{{dateA}}" bindchange="handleFieldInput" data-field="dateA">
      <view class="field">起始：{{dateA}}</view>
    </picker>
    <picker mode="date" value="{{dateB}}" bindchange="handleFieldInput" data-field="dateB">
      <view class="field">结束：{{dateB}}</view>
    </picker>
    <button class="btn-primary" data-action="run" bindtap="handleAction">计算相差</button>
  </block>

  <!-- Lorem -->
  <block wx:elif="{{slug === 'lorem-generator'}}">
    <view class="field">段落数 {{loremCount}}</view>
    <slider min="1" max="8" value="{{loremCount}}" show-value data-field="loremCount" bindchange="onSlider" bindchanging="onSlider" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">生成</button>
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制</button>
    </view>
  </block>

  <!-- Text diff -->
  <block wx:elif="{{slug === 'text-diff'}}">
    <textarea class="field area" placeholder="原文" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <textarea class="field area" placeholder="对比文本" value="{{inputText2}}" data-field="inputText2" bindinput="handleFieldInput" />
    <button class="btn-primary" data-action="run" bindtap="handleAction">对比</button>
    <view class="diff" wx:if="{{diffRows.length}}">
      <view wx:for="{{diffRows}}" wx:key="index" class="diff-row {{item.type}}">{{item.type === 'add' ? '+ ' : item.type === 'del' ? '- ' : '  '}}{{item.text}}</view>
    </view>
  </block>

  <!-- Markdown -->
  <block wx:elif="{{slug === 'markdown-preview'}}">
    <textarea class="field area" placeholder="# 标题\n**粗体** *斜体* `代码`" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <button class="btn-primary" data-action="run" bindtap="handleAction">预览</button>
    <rich-text wx:if="{{card.mdNodes.length}}" class="md glass-card" nodes="{{card.mdNodes}}"></rich-text>
  </block>

  <!-- QR -->
  <block wx:elif="{{slug === 'qrcode'}}">
    <textarea class="field area" placeholder="链接或文本" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">生成二维码</button>
      <button class="btn-ghost flex-1" bindtap="saveQrImage" disabled="{{!card.qrSize}}">保存到相册</button>
    </view>
    <view class="row gap-md" style="margin-top: 8px;">
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制内容</button>
    </view>
    <view wx:if="{{card.qrSize}}" class="qr-wrap glass-card">
      <view
        class="qr-grid"
        style="grid-template-columns: repeat({{card.qrSize}}, 1fr); width: {{card.qrSize * 8}}rpx; height: {{card.qrSize * 8}}rpx;"
      >
        <block wx:for="{{card.qrRows}}" wx:for-item="row" wx:key="key">
          <view
            wx:for="{{row.cells}}"
            wx:for-item="cell"
            wx:key="key"
            class="qr-cell {{cell.on ? 'on' : ''}}"
          ></view>
        </block>
      </view>
      <text class="hint">矩阵 {{card.qrSize}}×{{card.qrSize}} · 可保存 PNG 到相册</text>
    </view>
    <canvas
      canvas-id="qrSaveCanvas"
      id="qrSaveCanvas"
      class="qr-save-canvas"
      style="width: {{card.qrCanvasPx}}px; height: {{card.qrCanvasPx}}px;"
    ></canvas>
  </block>

  <!-- Offline tools (catalog-hidden; keep branches for STRICT parity) -->
  <block wx:elif="{{slug === 'weather' || slug === 'ip-lookup' || slug === 'text-to-speech'}}">
    <view class="glass-card offline-card">
      <text class="text-headline-sm">该工具已暂时下线</text>
      <text class="hint">正式版暂不提供天气、IP 查询与系统朗读。目录中已隐藏入口。</text>
    </view>
  </block>

  <!-- Compass -->
  <block wx:elif="{{slug === 'compass'}}">
    <view class="compass glass-card">
      <view class="compass-ring">
        <text class="compass-mark n">N</text>
        <text class="compass-mark e">E</text>
        <text class="compass-mark s">S</text>
        <text class="compass-mark w">W</text>
        <view class="needle" style="transform: rotate({{compassHeading}}deg);"></view>
      </view>
      <text class="heading">{{compassHeading}}° · {{compassLabel}}</text>
    </view>
    <button class="btn-ghost" data-action="run" bindtap="handleAction">重新校准</button>
    <text class="hint">需真机与运动方向权限；模拟器可能无读数。</text>
  </block>

  <!-- Pomodoro -->
  <block wx:elif="{{slug === 'pomodoro'}}">
    <view class="timer glass-card">
      <text class="timer-num">{{pomodoroLabel}}</text>
      <text class="hint">{{pomodoroMode === 'break' ? '休息 5 分钟' : '专注 25 分钟'}}</text>
    </view>
    <view class="row gap-md">
      <button class="btn-ghost flex-1 {{pomodoroMode === 'focus' ? 'active-chip' : ''}}" data-action="focus" bindtap="handleAction">专注 25</button>
      <button class="btn-ghost flex-1 {{pomodoroMode === 'break' ? 'active-chip' : ''}}" data-action="break" bindtap="handleAction">休息 5</button>
    </view>
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="toggle" bindtap="handleAction">{{pomodoroRunning ? '暂停' : '开始'}}</button>
      <button class="btn-ghost flex-1" data-action="reset" bindtap="handleAction">重置</button>
    </view>
  </block>

  <!-- Timer / stopwatch -->
  <block wx:elif="{{slug === 'timer-stopwatch'}}">
    <view class="timer glass-card">
      <text class="timer-num">{{stopwatchLabel}}</text>
      <text class="hint">秒表</text>
    </view>
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="sw-toggle" bindtap="handleAction">{{stopwatchRunning ? '暂停' : '开始'}}</button>
      <button class="btn-ghost flex-1" data-action="sw-reset" bindtap="handleAction">重置</button>
    </view>
    <view class="timer glass-card">
      <text class="timer-num">{{countdownLeft}} s</text>
      <text class="hint">倒计时</text>
    </view>
    <input class="field" type="number" placeholder="倒计时秒数" value="{{countdownSec}}" data-field="countdownSec" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="cd-toggle" bindtap="handleAction">{{countdownRunning ? '暂停' : '开始'}}</button>
      <button class="btn-ghost flex-1" data-action="cd-reset" bindtap="handleAction">重置</button>
    </view>
  </block>

  <!-- Fallback -->
  <block wx:else>
    <textarea class="field area" placeholder="输入内容开始使用「{{tool.title}}」" value="{{inputText}}" data-field="inputText" bindinput="handleFieldInput" />
    <view class="row gap-md">
      <button class="btn-primary flex-1" data-action="run" bindtap="handleAction">运行</button>
      <button class="btn-ghost flex-1" data-action="copy" bindtap="handleAction">复制结果</button>
    </view>
  </block>

  <result-card wx:if="{{result}}" title="结果" content="{{result}}" status="{{resultStatus}}" />
</tool-shell>
