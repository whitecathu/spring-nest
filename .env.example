VITE_APP_NAME=Spring Nest
VITE_APP_STORAGE_PREFIX=spring_nest

# Public site origin used for canonical URLs, sitemap, robots, and static route metadata.
# Do not set this to a temporary branch deployment such as master.spring-nest.pages.dev.
VITE_SITE_URL=https://spring-nest.pages.dev

# Supabase (optional - leave empty for guest/localStorage mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
