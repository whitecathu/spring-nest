{
  "name": "spring-nest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "generate:miniapp": "tsx scripts/generate-miniapp-tools.ts",
    "generate:site-assets": "tsx scripts/generate-site-assets.ts",
    "generate:all": "npm run generate:site-assets && npm run generate:miniapp",
    "check:generated": "npm run generate:all && git diff --exit-code -- README.md public/sitemap.xml public/robots.txt miniapp/data/tools.js",
    "generate:sitemap": "npm run generate:site-assets",
    "prebuild": "npm run generate:site-assets",
    "build": "vite build",
    "postbuild": "node scripts/generate-route-heads.mjs",
    "preview": "vite preview",
    "clean": "npx rimraf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:miniapp": "tsx scripts/verify-miniapp-foundation.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lhci": "lhci autorun",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/vite": "^4.1.14",
    "docx": "^9.6.1",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "read-excel-file": "9.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.1",
    "typescript-eslint": "8.65.0",
    "typescript": "~5.8.2",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "dompurify": "3.4.12",
    "esbuild": "0.25.12",
    "fast-uri": "4.1.1",
    "js-yaml": "5.2.2",
    "postcss": "8.5.25",
    "tmp": "0.2.7",
    "undici": "7.28.0",
    "ws": "8.21.1"
  }
}
